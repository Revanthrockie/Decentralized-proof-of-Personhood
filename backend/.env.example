# Google Gemini API key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Pinata IPFS credentials (get from https://pinata.cloud/)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_here

# Polygon Amoy Testnet RPC
RPC_URL=https://rpc-amoy.polygon.technology/

# The private key of the wallet that OWNS the deployed contract (backend minter)
MINTER_PRIVATE_KEY=your_minter_wallet_private_key_here

# Contract address after deployment (from: npm run deploy in contracts/)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# --- Anti-Sybil face-duplicate detection ------------------------------------
# Blocks a second wallet from minting with the same face. This is what
# enforces "one human = one token" when someone tries a new wallet instead
# of a new face. Keep "true" for the real demo.
ENABLE_FACE_DEDUP=true
FACE_MATCH_THRESHOLD=0.93

# Minimum fraction of the prompted sentence the transcript must match to
# pass the voice-liveness challenge.
AUDIO_MATCH_THRESHOLD=0.65

# Rehearsal-only: set to "true" on your OWN machine to enable
# POST /dev/reset-face-registry, which wipes the local face registry so you
# can re-run the demo without tripping your own earlier test mints. Leave
# "false" (or unset) for the actual presentation / any real deployment.
ALLOW_DEMO_RESET=false
